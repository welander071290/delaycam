{
  "name": "delaycamapp",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:web": "tsc -b && vite build --outDir docs --emptyOutDir",
    "lint": "oxlint",
    "preview": "vite preview",
    "electron:dev": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win portable",
    "dist:win:folder": "npm run build && electron-builder --win dir"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "oxlint": "^1.89.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.5"
  },
  "build": {
    "appId": "com.delaycam.app",
    "productName": "DelayCam",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "DelayCam-${version}-portable.exe"
    },
    "portable": {
      "requestExecutionLevel": "user"
    }
  }
}
